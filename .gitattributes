# Normalize text files to LF on every platform; Git auto-detects binary files.
* text=auto eol=lf

# Keep vector artwork reviewable in diffs.
*.svg text

# Store raster images, slide decks, and video assets with Git LFS.
*.avif filter=lfs diff=lfs merge=lfs -text
*.bmp filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.heic filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text
